From 14d2383ce2cb0527f4b9f90fd766c951fd4f093f Mon Sep 17 00:00:00 2001
From: lassulus <git@lassul.us>
Date: Thu, 15 Oct 2026 17:39:22 +0200
Subject: [PATCH] atuin: fix e2e tests in unsandboxed darwin builds

The e2e tests run an interactive bash, which reads the host's /etc/bashrc
when the build is not sandboxed (the default on darwin). nix-darwin's
/etc/bashrc resets PATH, dropping the test home's bin directory that holds
the atuin under test, so the shell integration ran whatever atuin the host
has (or none) and filtered_commands_leave_no_captured_output timed out
waiting for captured output.

The NixOS and nix-darwin /etc/bashrc return early when NOSYSBASHRC is set,
so set it for the check phase.

Assisted-by: omp (Claude Opus 5.5)
---
 pkgs/by-name/at/atuin/package.nix | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/pkgs/by-name/at/atuin/package.nix b/pkgs/by-name/at/atuin/package.nix
index cbd861321beb5..d234ae79769dc 100644
--- a/pkgs/by-name/at/atuin/package.nix
+++ b/pkgs/by-name/at/atuin/package.nix
@@ -76,6 +76,12 @@ rustPlatform.buildRustPackage (finalAttrs: {
 
   preCheck = ''
     export HOME=$(mktemp -d)
+    # The e2e tests start an interactive bash, which sources the host's
+    # /etc/bashrc when the build is not sandboxed (the darwin default).
+    # The nix-darwin config resets PATH, so if the user has atuin installed,
+    # the shell integration runs the system atuin instead of the one currently building
+    # and no output is captured.
+    export NOSYSBASHRC=1
   '';
 
   __darwinAllowLocalNetworking = true;
